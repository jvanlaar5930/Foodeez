# Copy this file to .env and fill in real values. Never commit .env.

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=foodeez
MYSQL_USER=foodeez
MYSQL_PASSWORD=change_me_password

# API
JWT_KEY=replace_with_a_32_character_minimum_secret
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
SPOONACULAR_API_KEY=
FOODDATA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ASPNETCORE_ENVIRONMENT=Production

# Self-hosted AI providers. Leave as-is unless you run one; note that "localhost" from inside
# the API container is the container, not your machine - use host.docker.internal for a model
# server running on the host.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LOCALAI_BASE_URL=http://localhost:1234/v1
LOCALAI_MODEL=local-model
LOCALAI_API_KEY=

# Only set this if a browser app is served from somewhere other than the bundled nginx, which
# proxies /api/ and so is already same-origin. Empty means no cross-origin calls are allowed.
CORS_ALLOWED_ORIGIN=

# Web
WEB_PORT=8080

# Apply pending EF Core migrations when the API container starts. True is what this stack has
# always done and suits a single instance. Set it false if you would rather run migrations
# deliberately - a migration is a one-way change to your data.
DB_AUTO_MIGRATE=true
