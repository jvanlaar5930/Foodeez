<Project>

  <!--
    One place where every package version is decided.

    Versions used to be written into each csproj, and they had drifted apart:
    Microsoft.Extensions.Logging.Abstractions was on 10.0.0 in one project while every other
    Microsoft package sat on 9.0.0, which is the kind of thing that only shows up as a
    runtime binding failure. Central package management makes a mismatch impossible to
    express rather than merely unlikely.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Runtime">
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.10.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <!--
    EF Core stays on 9.x because Pomelo does. Pomelo.EntityFrameworkCore.MySql 9.0.0 is the
    newest there is, and a provider is built against one EF Core major version - pulling
    EF Core 10 in beside it is how you get a startup that cannot construct a DbContext.
    These three move together, when Pomelo moves.
  -->
  <ItemGroup Label="Entity Framework (pinned to what Pomelo supports)">
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
  </ItemGroup>

  <!--
    Swashbuckle 8 moved to Microsoft.OpenApi 2.x, which renamed and reshaped the types
    Program.cs builds its security scheme from. Worth doing, but as its own change with the
    Swagger UI actually opened afterwards - not folded into a version sweep.
  -->
  <ItemGroup Label="Swagger (held back deliberately)">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
