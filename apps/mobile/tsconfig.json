{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@foodeez/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@foodeez/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@foodeez/brand/*": [
        "../../packages/brand/*"
      ]
    },
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts"
  ]
}
